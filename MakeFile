# Makefile for Restaurant Intel project
# If a command line errors, make stops immediately

.DEFAULT_GOAL := help

.PHONY: help dev up down logs ps dbshell api shell worker \
		backend-test backend-lint backend-fmt \
		frontend-install frontend-lint frontend-build \
		docker-build clean migration migrate migrate-down dbshell-alembic \

help: ## Show available commands
	@echo ""
	@echo "Usage: make <target>"
	@echo ""
	@echo "Common targets:"
	@echo "  dev               Start everything (db, backend, worker, frontend)"
	@echo "  down			         Stop containers"
	@echo "  logs              Tail logs"
	@echo "  backend-test	     Run backend tests"
	@echo "  backend-lint      Lint backend"
	@echo "  backend-fmt       Format backend"
	@echo "  frontend-lint     Lint frontend"
	@echo "  frontend-build    Build frontend"
	@echo "  docker-build      Build backend + frontend Docker images"
	@echo ""

dev: ## Build and start all services
	docker compose up --build

up: ## Start services (no build)
	docker compose up

down: ## Stop services
	docker compose down

logs: ## Follow logs for all services
	docker compose logs -f

ps: ## Show running services
	docker compose ps

dbshell: ## Open a psql shell inside the db container
	docker compose exec db psql -U postgres -d app

api: ## Open a shell inside the backend container
	docker compose exec backend bash

worker: ## Open a shell inside the worker container
	docker compose exec worker bash

backend-test: ## Run backend test suite (pytest)
	docker compose run --rm backend pytest -q

backend-lint: ## Lint backend with ruff
	docker compose run --rm backend ruff check .

backend-fmt: ## Format backend code with ruff
	docker compose run --rm backend ruff format .

frontend-install: ## Install frontend deps
	docker compose run --rm frontend pnpm install

frontend-lint: ## Lint frontend code
	docker compose run --rm frontend pnpm lint

frontend-build: ## Build frontend code
	docker compose run --rm frontend pnpm build

docker-build: ## Build Docker images for backend and frontend
	docker build -t ri-backend:local ./backend
	docker build -t ri-frontend:local ./frontend

clean: ## Remove local data + dangling docker artifacts
	docker compose down -v
	rm -rf .data

migration: ## Create new migration (use: make migration msg="add users table")
	docker compose run --rm backend alembic -c app/db/alembic.ini revision --autogenerate -m "$(msg)"

migrate: ## Apply pending migrations
	docker compose run --rm backend alembic -c app/db/alembic.ini upgrade head

migrate-down: ## Rollback last migration
	docker compose run --rm backend alembic -c app/db/alembic.ini downgrade -1

db-reset: ## Drop database and recreate (DESTRUCTIVE)
	docker compose down -v
	docker compose up -d db
	sleep 2
	make migrate

shell-backend: ## Python shell in backend container
	docker compose exec backend uv run python

shell-frontend: ## Node shell in frontend
	docker compose exec frontend sh

prune: ## Remove all containers, volumes, and images (DESTRUCTIVE)
	docker compose down -v --remove-orphans
	docker system prune -af
